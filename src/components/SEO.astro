---
import type { Locale } from '../i18n/locales';
import { LOCALE_CONFIG, SITE_META } from '../i18n/locales';
import type { SEOProps } from '../lib/seo';
import { resolveCanonical, resolveSiteOrigin } from '../lib/site-url';

interface Props extends SEOProps {
  title: string;
  locale?: Locale;
  alternateUrl?: string;
}

const {
  title,
  description,
  image = '/og-default.svg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  keywords = [],
  noindex = false,
  locale = 'en',
  alternateUrl,
} = Astro.props;

const site = SITE_META[locale];
const localeConfig = LOCALE_CONFIG[locale];
const canonical = resolveCanonical(Astro.site, Astro.url);
const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const ogImage = new URL(image, `${siteUrl}/`).href;
const allKeywords = [...keywords, ...tags];
const altLocale = locale === 'en' ? 'zh' : 'en';
const altHreflang = LOCALE_CONFIG[altLocale].htmlLang;
---

<title>{title}</title>
<meta name="description" content={description} />
{allKeywords.length > 0 && <meta name="keywords" content={allKeywords.join(', ')} />}
<meta name="author" content={author ?? site.name} />
<meta name="geo.region" content={site.region} />
<meta name="geo.placename" content="Hong Kong" />
<meta name="language" content={localeConfig.language} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="alternate" hreflang={localeConfig.htmlLang} href={canonical} />
{alternateUrl && <link rel="alternate" hreflang={altHreflang} href={alternateUrl} />}
<link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : (alternateUrl ?? canonical)} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeConfig.ogLocale} />
{alternateUrl && (
  <meta property="og:locale:alternate" content={LOCALE_CONFIG[altLocale].ogLocale} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: localeConfig.htmlLang,
  ...(type === 'article' && {
    headline: title,
    datePublished: publishedTime,
    dateModified: modifiedTime ?? publishedTime,
    author: { '@type': 'Person', name: author },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: siteUrl,
    },
    image: ogImage,
    ...(allKeywords.length > 0 && { keywords: allKeywords.join(', ') }),
  }),
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteUrl,
  description: site.description,
  inLanguage: [LOCALE_CONFIG.en.htmlLang, LOCALE_CONFIG.zh.htmlLang],
  about: locale === 'en'
    ? ['Search engine optimization', 'Generative engine optimization', 'AI search', 'Structured data']
    : ['搜尋引擎優化', '生成式引擎優化', 'AI 搜尋', '結構化數據'],
})} />
